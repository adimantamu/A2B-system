# Copy to .env. Every value below has a working default — the system runs with
# no .env at all, which is deliberate for a skeleton.

# Where the SQLite database and generated packages live.
# A2B_DATA_DIR=./data
# A2B_DB_PATH=./data/a2b.db
# A2B_PACKAGE_DIR=./data/packages

# The WebMCP endpoint compiled into every entry prompt. This is baked into links
# that customers paste into their own AI, so in anything but local development it
# must be the externally reachable host.
# A2B_MCP_BASE=api.lenni.io/mcp

# Transactional email. Production uses the EC2 instance role, so these settings
# contain no AWS access key or secret. A2B_SITE_BASE must be the origin serving
# /reset-password and /signup; leaving it unset locally writes messages to the
# data/outbox directory instead of sending them.
# A2B_EMAIL_BACKEND=ses
# A2B_EMAIL_FROM=no-reply@lenni.io
# A2B_SITE_BASE=https://console.lenni.io
# AWS_REGION=us-east-2

# Port for run.sh.
# PORT=8000
