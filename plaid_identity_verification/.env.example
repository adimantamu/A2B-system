# Public route through the existing A2B staging Cloudflare tunnel.
PIV_PUBLIC_BASE=https://a2b-staging.lenni.io/plaid-demo
PIV_BASE_PATH=/plaid-demo
PIV_DATA_DIR=/var/lib/plaid_identity_verification
PIV_COOKIE_SECURE=1
PIV_SESSION_TTL_SECONDS=43200

# Safe default. This simulator never collects SSNs, ID images, or biometrics.
PIV_PROVIDER=demo

# Reuses A2B_EMAIL_BACKEND / A2B_EMAIL_FROM by default.
# PIV_EMAIL_BACKEND=ses
# PIV_EMAIL_FROM=no-reply@lenni.io

# To use Plaid, configure an IDV template in the Plaid Dashboard, then set:
# PIV_PROVIDER=plaid
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_IDV_TEMPLATE_ID=idvtmp_...
#
# Also register this webhook in Plaid Dashboard > Developers > Webhooks:
# https://a2b-staging.lenni.io/plaid-demo/webhooks/plaid
