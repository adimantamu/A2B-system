PIV_PUBLIC_BASE=https://a2b-staging.lenni.io/plaid-demo
PIV_BASE_PATH=/plaid-demo
PIV_DATA_DIR=/var/lib/plaid_identity_verification
PIV_COOKIE_SECURE=1
PIV_SESSION_TTL_SECONDS=43200
PIV_PROVIDER=demo
PIV_EMAIL_BACKEND=ses

# Add Plaid Sandbox values and change PIV_PROVIDER to plaid when ready:
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_IDV_TEMPLATE_ID=
